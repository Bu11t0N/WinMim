<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">
  <Package Name="WinMim Preview" Manufacturer="WinMim contributors"
           Version="$(var.Version)" UpgradeCode="{FB77EEDA-1925-4838-8EEF-A3E609BD779E}"
           Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of WinMim Preview is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="WINMIMWINDOWSMAJOR" Secure="yes">
      <RegistrySearch Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentMajorVersionNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR (Msix64 AND WINMIMWINDOWSMAJOR)"
            Message="WinMim requires 64-bit Windows 10 or later." />
    <netfx:DotNetCompatibilityCheck Property="WINMIMDESKTOPRUNTIME" Platform="x64"
                                    RuntimeType="desktop" Version="10.0.0" RollForward="latestPatch" />
    <Launch Condition='Installed OR WINMIMDESKTOPRUNTIME = "0"'
            Message="Install the x64 .NET 10 Desktop Runtime before installing WinMim." />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Bu11t0N/WinMim" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="WinMim" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="WINMIMMENU" Name="WinMim Preview">
        <Component Id="StartShortcuts" Guid="{65CB9602-0DA4-494B-891E-AF4FAF5B0D2F}">
          <Shortcut Id="WinMimShortcut" Name="WinMim Preview" Target="[INSTALLFOLDER]WinMim.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <Shortcut Id="WinMimFilesShortcut" Name="WinMim Files" Target="[INSTALLFOLDER]WinMim.exe"
                    Arguments="--retro-files" WorkingDirectory="INSTALLFOLDER" />
          <Shortcut Id="WinMimRecoverShortcut" Name="WinMim Restore Desktop" Target="[INSTALLFOLDER]WinMim.exe"
                    Arguments="--restore-theme" WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveWinMimMenu" On="uninstall" />
          <RegistryValue Root="HKLM" Key="Software\WinMim" Name="PreviewInstalled"
                         Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="WinMim" Title="WinMim Preview" Level="1">
      <ComponentRef Id="StartShortcuts" />
      <Files Directory="INSTALLFOLDER" Include="$(var.Payload)\**" />
    </Feature>
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
  </Package>
</Wix>
